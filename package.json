{
  "name": "sc-mikrotik",
  "version": "0.0.4",
  "description": "TypeScript client for the MikroTik RouterOS REST API.",
  "license": "ISC",
  "author": {
    "name": "Saulo Costa",
    "url": "https://github.com/saulotarsobc"
  },
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saulotarsobc/sc-mikrotik.git"
  },
  "bugs": {
    "url": "https://github.com/saulotarsobc/sc-mikrotik/issues"
  },
  "homepage": "https://github.com/saulotarsobc/sc-mikrotik#readme",
  "keywords": [
    "mikrotik",
    "routeros",
    "rest",
    "api",
    "typescript"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:package": "npm pack --dry-run",
    "prepublishOnly": "npm run build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "axios": "^1.16.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "dotenv": "^17.4.2",
    "rimraf": "^6.1.3",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}